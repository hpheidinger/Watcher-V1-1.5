ruleset-wordpress() {
local funtag="[${FUNCNAME[0]}]"
: FILTER_STATE=[refresh]
: FILTER_DATE=2026-01-03T18:15:49+01:00

RULE=NO_RULESET_MATCH-$funtag
return 0
}
