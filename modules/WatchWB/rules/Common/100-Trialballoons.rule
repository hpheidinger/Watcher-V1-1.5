#
# Trial baloons to inspect the system
#
WEB_CLASS=Trialbaloons
###############################
RULE=Double-Dash
Pattern="GET //"
#---------------
if [[ "$REPLY" =~ "$Pattern" ]]; then kickoff; return $?; fi

